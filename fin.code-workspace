{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
      "tests"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Fin: Run",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "fin"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        }
      },
      {
        "label": "Fin: DB Init",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "fin",
          "db",
          "init"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "detail": "Create/migrate ~/.local/share/fin/fin.sqlite3 (outside Git); copy old data/ database when needed"
      },
      {
        "label": "Fin: DB Status",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "fin",
          "db",
          "status"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "detail": "Read-only health check for database outside repository"
      },
      {
        "label": "Fin: Web",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "fin",
          "web"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "detail": "Run local Bank browser UI at http://127.0.0.1:8765 (requires Fin: DB Init)"
      },
      {
        "label": "Fin: Tests",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "pytest",
          "-v"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        }
      },
      {
        "label": "Fin: Ruff Check",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "command": "${workspaceFolder}/.venv/bin/ruff",
        "args": [
          "check",
          "."
        ]
      },
      {
        "label": "Fin: Ruff Format Check",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "command": "${workspaceFolder}/.venv/bin/ruff",
        "args": [
          "format",
          "--check",
          "."
        ]
      },
      {
        "label": "Fin: Ruff Format",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "command": "${workspaceFolder}/.venv/bin/ruff",
        "args": [
          "format",
          "."
        ]
      },
      {
        "label": "Fin: Setup",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "command": "bash",
        "args": [
          "-lc",
          "if [ ! -x .venv/bin/python ]; then python3 -m venv .venv; fi; .venv/bin/python -m pip --version"
        ],
        "detail": "Idempotent WSL environment setup; do not recreate existing .venv"
      },
      {
        "label": "Fin: Install",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "pip",
          "install",
          "-e",
          {
            "value": ".[dev]",
            "quoting": "strong"
          }
        ],
        "detail": "Create .venv when missing, then install/update editable Fin and dev dependencies",
        "dependsOn": [
          "Fin: Setup"
        ],
        "dependsOrder": "sequence"
      },
      {
        "label": "Fin: Check",
        "dependsOn": [
          "Fin: Ruff Check",
          "Fin: Ruff Format Check",
          "Fin: Tests"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "detail": "Run lint, format check, and tests before a PR"
      },
      {
        "label": "Fin: Bootstrap",
        "dependsOn": [
          "Fin: Install",
          "Fin: DB Init"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": [],
        "detail": "First-run setup, install, and safe SQLite initialization"
      },
      {
        "label": "Fin: Babki Import",
        "type": "shell",
        "command": "${workspaceFolder}/.venv/bin/python",
        "args": [
          "-m",
          "fin",
          "babki",
          "import",
          "${input:babkiFile}"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "detail": "Stage Babki.xlsx rows into the visible Bank import preview, no financial booking"
      }
    ],
    "inputs": [
      {
        "id": "babkiFile",
        "type": "promptString",
        "description": "Absolute WSL path to downloaded Babki.xlsx",
        "default": "~/Downloads/Babki.xlsx"
      }
    ]
  }
}
